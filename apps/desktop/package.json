{
  "name": "@fledge/desktop",
  "version": "0.7.3",
  "private": true,
  "description": "Fledge desktop application (Tauri)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:vite": "vite --port 1420 --strictPort",
    "dev:promo": "vite --port 1420 --strictPort",
    "record:promo": "node scripts/record-promo.mjs",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@fledge/i18n": "workspace:*",
    "@fledge/shared": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.68.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "i18next": "^24.2.3",
    "modern-screenshot": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.4.0",
    "skinview3d": "^3.4.2",
    "three": "0.156.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@types/three": "0.156.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.51.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
