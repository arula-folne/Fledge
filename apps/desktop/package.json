{
  "name": "@fledge/desktop",
  "version": "0.1.13-a",
  "private": true,
  "description": "Fledge desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "thumbs:skins": "electron ./scripts/render-default-skin-thumbs.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src electron --max-warnings 0",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@fledge/core": "workspace:*",
    "@fledge/i18n": "workspace:*",
    "@fledge/shared": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.68.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xmcl/core": "2.16.0",
    "@xmcl/installer": "6.3.1",
    "i18next": "^24.2.3",
    "msmc": "^5.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.4.0",
    "skinview3d": "^3.4.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "net.folne.fledge",
    "productName": "Fledge",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/microsoft-login.png",
        "to": "microsoft-login.png"
      },
      {
        "from": "resources/microsoft-login.ico",
        "to": "microsoft-login.ico"
      },
      {
        "from": "resources/skins",
        "to": "skins"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "uninstallDisplayName": "Fledge",
      "unicode": true,
      "installerLanguages": [
        "ja_JP",
        "en_US"
      ],
      "language": "1041",
      "license": "build/license.txt",
      "include": "installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "artifactName": "Fledge-Setup.exe"
  }
}
