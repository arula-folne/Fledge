{
  "name": "@fledge/desktop",
  "version": "0.5.3",
  "private": true,
  "description": "Fledge desktop application (Tauri)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite --port 1420 --strictPort",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "dev:electron": "echo Electron is deprecated in 0.5 — use pnpm dev (Tauri) && exit 1",
    "build:electron": "echo Electron is deprecated in 0.5 — use pnpm build / tauri:build && exit 1",
    "dist:electron": "echo Electron is deprecated in 0.5 — use pnpm tauri:build && exit 1"
  },
  "dependencies": {
    "@fledge/i18n": "workspace:*",
    "@fledge/shared": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.68.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "i18next": "^24.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.4.0",
    "skinview3d": "^3.4.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
