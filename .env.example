# Fledge local environment (DO NOT COMMIT real secrets)
# Copy to `.env` and fill values. `.env` is gitignored.
#
# CurseForge API key is NOT configurable in the settings UI.
# Put your own key here for local / production machines only.
# Never commit the real value. Never push it to GitHub (CurseForge ToS).

FLEDGE_CURSEFORGE_API_KEY=
