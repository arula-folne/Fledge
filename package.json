{
  "name": "fledge",
  "private": true,
  "version": "0.3.3-b",
  "description": "軽快・モダンな UI と使い勝手を重視した Minecraft ランチャー",
  "license": "GPL-3.0",
  "author": "folne",
  "repository": {
    "type": "git",
    "url": "https://github.com/arula-folne/Fledge.git"
  },
  "scripts": {
    "postinstall": "node scripts/patch-xmcl.js",
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "pnpm --filter @fledge/desktop dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.4.0",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
